# DEMO ONLY. Replace every password in your private .env before non-demo use.
# Single-quoted Compose values preserve $ literally; escape an embedded quote with \'.
POSTGRES_PASSWORD='DEMO bootstrap password'
FCG_USERS_DB_PASSWORD='DEMO users password'
FCG_CATALOG_DB_PASSWORD='DEMO catalog password'
FCG_PAYMENTS_DB_PASSWORD='DEMO payments password'
FCG_NOTIFICATIONS_DB_PASSWORD='DEMO notifications password'
POSTGRES_PORT=5432

# Public DEMO credentials for disposable local infrastructure only.
RABBITMQ_BOOTSTRAP_USER=fcg_bootstrap
RABBITMQ_BOOTSTRAP_PASSWORD='DEMO_rabbit_admin'
FCG_USERS_RABBITMQ_USER=fcg_users
FCG_USERS_RABBITMQ_PASSWORD='DEMO_rabbit_users'
FCG_CATALOG_RABBITMQ_USER=fcg_catalog
FCG_CATALOG_RABBITMQ_PASSWORD='DEMO_rabbit_catalog'
FCG_PAYMENTS_RABBITMQ_USER=fcg_payments
FCG_PAYMENTS_RABBITMQ_PASSWORD='DEMO_rabbit_payments'
FCG_NOTIFICATIONS_RABBITMQ_USER=fcg_notifications
FCG_NOTIFICATIONS_RABBITMQ_PASSWORD='DEMO_rabbit_notifications'
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_BOOTSTRAP_TIMEOUT_SECONDS=60
