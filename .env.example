# DEMO ONLY. Replace every password in your private .env before non-demo use.
# Single-quoted Compose values preserve $ literally; escape an embedded quote with \'.
POSTGRES_PASSWORD='DEMO bootstrap password'
FCG_USERS_DB_PASSWORD='DEMO users password'
FCG_CATALOG_DB_PASSWORD='DEMO catalog password'
FCG_PAYMENTS_DB_PASSWORD='DEMO payments password'
FCG_NOTIFICATIONS_DB_PASSWORD='DEMO notifications password'
POSTGRES_PORT=5432

# Public DEMO credentials for disposable local infrastructure only.
RABBITMQ_BOOTSTRAP_USER=fcg_bootstrap
RABBITMQ_BOOTSTRAP_PASSWORD='DEMO_rabbit_admin'
FCG_USERS_RABBITMQ_USER=fcg_users
FCG_USERS_RABBITMQ_PASSWORD='DEMO_rabbit_users'
FCG_CATALOG_RABBITMQ_USER=fcg_catalog
FCG_CATALOG_RABBITMQ_PASSWORD='DEMO_rabbit_catalog'
FCG_PAYMENTS_RABBITMQ_USER=fcg_payments
FCG_PAYMENTS_RABBITMQ_PASSWORD='DEMO_rabbit_payments'
FCG_NOTIFICATIONS_RABBITMQ_USER=fcg_notifications
FCG_NOTIFICATIONS_RABBITMQ_PASSWORD='DEMO_rabbit_notifications'
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_BOOTSTRAP_TIMEOUT_SECONDS=60

# Prepare verified source checkouts and persist keys before starting applications.
# scripts/prepare-local.py creates a PRIVATE environment with random local credentials.
FCG_USERS_SOURCE=./.sources/users
FCG_CATALOG_SOURCE=./.sources/catalog
FCG_PAYMENTS_SOURCE=./.sources/payments
FCG_NOTIFICATIONS_SOURCE=./.sources/notifications
FCG_USERS_PORT=8081
FCG_CATALOG_PORT=8082
FCG_PAYMENTS_PORT=8083
FCG_NOTIFICATIONS_PORT=8084
FCG_JWT_PUBLIC_KEY_PATH=./.local/demo/public.pem
FCG_JWT_PRIVATE_KEY_PATH=./.local/demo/private.pem
FCG_JWT_ISSUER=fcg-users-api
FCG_JWT_AUDIENCE=fcg-clients
FCG_SWAGGER_ENABLED=false
# No bootstrap credential defaults. Supply all four values when enabling.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_PLAYER_EMAIL=
ADMIN_BOOTSTRAP_PLAYER_PASSWORD=
PAYMENT_APPROVAL_LIMIT=500.00
PAYMENT_DELAY=00:00:02

# Local PostgreSQL roles authenticate with passwords; no Kerberos runtime dependency. SSL mode is separate.
FCG_GSS_ENCRYPTION_MODE=disable
